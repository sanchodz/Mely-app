# =============================================================================
# FINDY — frontend (Vite + Capacitor) — variables de entorno
#
# Copiá este archivo a `.env.local` para desarrollo. Nunca commitees `.env.local`.
#
# IMPORTANTE: todas las variables `VITE_*` se hornean en el bundle del cliente
# (web, APK e iOS). Son PÚBLICAS por diseño. Nunca pongas un secreto en una
# variable `VITE_*`. Los secretos viven solo en el backend (repo sanchodz/Mvp,
# ver `backend/.env.example` allá y HANDOVER.md acá).
#
# Prioridad en el build: env vars del hosting (Vercel) > `.env.production`
# (commiteado a propósito, solo valores públicos) > este archivo.
# =============================================================================

# VITE_API_URL — URL base del backend, sin barra final y sin `/api/v1`.
# Requerida. Si falta, la app apunta a http://localhost:4000.
#   Local: http://localhost:4000
#   Prod:  la URL de producción del proyecto Vercel del backend
VITE_API_URL="http://localhost:4000"

# VITE_GOOGLE_CLIENT_ID — Client ID OAuth 2.0 (tipo "Web application") de
# Google Cloud Console → APIs & Services → Credentials. Público.
# Debe ser el mismo valor que `GOOGLE_CLIENT_ID` en el backend.
# Opcional: vacío oculta el botón "Continuar con Google".
VITE_GOOGLE_CLIENT_ID=""

# VITE_VAPID_PUBLIC_KEY — mitad pública del par VAPID de Web Push. Debe ser el
# mismo valor que `VAPID_PUBLIC_KEY` en el backend (la privada queda solo allá).
# Opcional: vacío oculta el switch "Notificaciones push" en Ajustes.
VITE_VAPID_PUBLIC_KEY=""

# DISABLE_HMR — solo desarrollo. "true" desactiva HMR y el file watcher de Vite.
# DISABLE_HMR="false"
